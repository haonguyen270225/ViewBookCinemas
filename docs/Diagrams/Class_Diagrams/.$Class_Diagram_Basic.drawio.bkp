        <mxCell id="kJ6Mv3lKQDgK3Ldolyos-63" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;darkOpacity=0.05;fillStyle=solid;fontSize=6;direction=west;gradientDirection=north;shadow=1;size=20;pointerEvents=1;align=left;strokeColor=#FFF072;strokeWidth=3;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;rounded=0;" value="&lt;span style=&quot;font-size: 15px; font-weight: 700; text-align: center;&quot;&gt;UserController&amp;nbsp; &amp;nbsp;:&amp;nbsp;&lt;/span&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;Register(request: RegisterRequest): Task&amp;lt;UserDto&amp;gt; Đăng ký tài khoản mới, kiểm tra email và username, mã hóa mật khẩu, gán vai trò Customer.&lt;p&gt;&lt;code&gt;Login(request: LoginRequest): Task&amp;lt;AuthResponseDto&amp;gt;&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Kiểm tra tài khoản và mật khẩu, tạo thông tin xác thực đăng nhập.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;Logout(userId: int): Task&amp;lt;bool&amp;gt;&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Xử lý đăng xuất hoặc thu hồi phiên đăng nhập nếu hệ thống hỗ trợ.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;GetUserById(userId: int): Task&amp;lt;UserDto&amp;gt;&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Lấy thông tin người dùng theo mã.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;GetAllUsers(): Task&amp;lt;List&amp;lt;UserDto&amp;gt;&amp;gt;&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Lấy danh sách người dùng.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;UpdateProfile(userId: int, request: UpdateProfileRequest): Task&amp;lt;bool&amp;gt;&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Cập nhật hồ sơ người dùng.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;ChangePassword(userId: int, request: ChangePasswordRequest): Task&amp;lt;bool&amp;gt;&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Kiểm tra mật khẩu cũ và cập nhật mật khẩu mới.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;UpdateAvatar(userId: int, avatarUrl: string): Task&amp;lt;bool&amp;gt;&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Cập nhật ảnh đại diện.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;VerifyEmail(token: string): Task&amp;lt;bool&amp;gt;&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Kiểm tra mã xác thực email.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;ChangeUserRole(userId: int, roleId: int): Task&amp;lt;bool&amp;gt;&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Thay đổi vai trò của người dùng.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;DeactivateAccount(userId: int): Task&amp;lt;bool&amp;gt;&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Vô hiệu hóa tài khoản.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;GetBookingHistory(userId: int): Task&amp;lt;List&amp;lt;BookingDto&amp;gt;&amp;gt;&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Lấy lịch sử đặt vé của người dùng.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;GetUserReviews(userId: int): Task&amp;lt;List&amp;lt;MovieReviewDto&amp;gt;&amp;gt;&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Lấy danh sách đánh giá của người dùng.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="221" width="318" x="1037.27" y="1907" as="geometry" />
        </mxCell>
        <mxCell id="kJ6Mv3lKQDgK3Ldolyos-64" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;darkOpacity=0.05;fillStyle=solid;fontSize=6;direction=west;gradientDirection=north;shadow=1;size=20;pointerEvents=1;align=left;strokeColor=#FFF072;strokeWidth=3;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;rounded=0;" value="&lt;p&gt;&lt;code&gt;&lt;span style=&quot;font-family: Helvetica; font-size: 15px; font-weight: 700; text-align: center;&quot;&gt;UserService&amp;nbsp;&lt;/span&gt;&lt;/code&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;Register(request)&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;POST&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;/api/users/register&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Tiếp nhận yêu cầu đăng ký.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;Login(request)&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;POST&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;/api/users/login&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Tiếp nhận yêu cầu đăng nhập.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;Logout()&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;POST&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;/api/users/logout&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Tiếp nhận yêu cầu đăng xuất.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;GetUserById(userId)&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;GET&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;/api/users/{userId}&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Lấy thông tin người dùng.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;GetAllUsers()&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;GET&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;/api/users&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Lấy danh sách người dùng.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;UpdateProfile(request)&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;PUT&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;/api/users/profile&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Cập nhật hồ sơ.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;ChangePassword(request)&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;PUT&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;/api/users/change-password&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Đổi mật khẩu.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;UpdateAvatar()&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;PUT&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;/api/users/avatar&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Cập nhật ảnh đại diện.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;VerifyEmail(token)&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;GET&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;/api/users/verify-email&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Xác thực email.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;ChangeUserRole(userId, roleId)&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;PUT&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;/api/users/{userId}/role&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Thay đổi vai trò.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;DeactivateAccount(userId)&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;PATCH&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;/api/users/{userId}/deactivate&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Vô hiệu hóa tài khoản.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;GetBookingHistory() GET&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;/api/users/me/bookings&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Lấy lịch sử đặt vé của tài khoản đang đăng nhập.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;GetUserReviews()&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;GET&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;/api/users/me/reviews&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Lấy đánh giá của tài khoản đang đăng nhập.&lt;/span&gt;&lt;/p&gt;" vertex="1">
