fffff));&quot;&gt;/api/roles/{roleId}&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Tiếp nhận yêu cầu xóa vai trò.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;GetRoleById(roleId)&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;GET&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;/api/roles/{roleId}&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Lấy thông tin chi tiết vai trò.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;GetAllRoles()&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;GET&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;/api/roles&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Lấy danh sách vai trò.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;GetUsersByRole(roleId)&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;GET&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;/api/roles/{roleId}/users&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Lấy danh sách người dùng theo vai trò.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;ActivateRole(roleId)&amp;nbsp;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-d